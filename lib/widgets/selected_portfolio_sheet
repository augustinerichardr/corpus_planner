import 'package:flutter/material.dart';
import '../models/mutual_fund_model.dart';

class SelectedPortfolioSheet extends StatelessWidget {
  final List<MutualFundScheme> selectedSchemes;
  final String currencySymbol;
  final Function(MutualFundScheme) onRemove;

  const SelectedPortfolioSheet({
    super.key,
    required this.selectedSchemes,
    required this.currencySymbol,
    required this.onRemove,
  });

  @override
  Widget build(BuildContext context) {
    double totalSip = selectedSchemes.fold(0, (sum, item) => sum + item.allocatedSip);

    return Container(
      padding: const EdgeInsets.all(20),
      decoration: const BoxDecoration(
        color: Color(0xFF1E293B),
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              const Text('Active SIP Strategy Breakdown', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 16)),
              IconButton(
                icon: const Icon(Icons.close, color: Colors.grey),
                onPressed: () => Navigator.pop(context),
              ),
            ],
          ),
          const SizedBox(height: 8),
          Text(
            'Total Monthly Allocation: $currencySymbol${totalSip.toInt()} / mo',
            style: const TextStyle(color: Color(0xFF10B981), fontWeight: FontWeight.bold, fontSize: 15),
          ),
          const Divider(color: Colors.white12, height: 20),
          ConstrainedBox(
            constraints: const BoxConstraints(maxHeight: 280),
            child: ListView.builder(
              shrinkWrap: true,
              itemCount: selectedSchemes.length,
              itemBuilder: (context, index) {
                final scheme = selectedSchemes[index];
                return Container(
                  margin: const EdgeInsets.only(bottom: 8),
                  padding: const EdgeInsets.all(10),
                  decoration: BoxDecoration(
                    color: const Color(0xFF0F172A),
                    borderRadius: BorderRadius.circular(8),
                    border: Border.all(color: const Color(0xFF10B981).withOpacity(0.3)),
                  ),
                  child: Row(
                    children: [
                      Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Text(scheme.schemeName, style: const TextStyle(color: Colors.white, fontSize: 12, fontWeight: FontWeight.w600), maxLines: 1, overflow: TextOverflow.ellipsis),
                            const SizedBox(height: 2),
                            Text('$currencySymbol${scheme.allocatedSip.toInt()} / mo', style: const TextStyle(color: Color(0xFF10B981), fontWeight: FontWeight.bold, fontSize: 12)),
                          ],
                        ),
                      ),
                      IconButton(
                        icon: const Icon(Icons.delete_outline, color: Color(0xFFEF4444), size: 20),
                        onPressed: () => onRemove(scheme),
                      ),
                    ],
                  ),
                );
              },
            ),
          ),
        ],
      ),
    );
  }
}